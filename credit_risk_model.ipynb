    "import os\n",
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mtick\n",
    "from matplotlib.patches import FancyBboxPatch\n",
    "import seaborn as sns\n",
    "from IPython.display import display, Markdown\n",
    "from scipy.stats import norm\n",
    "from sklearn.datasets import fetch_openml\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import FunctionTransformer, StandardScaler\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import HistGradientBoostingClassifier\n",
    "from sklearn.metrics import roc_auc_score, roc_curve\n",
    "from sklearn.calibration import calibration_curve\n",
    "\n",
    "P = dict(\n",
    "    lgd=0.45, rho=0.15, margin=0.08,      # asumsi (lihat tabel di atas)\n",
    "    pdo=20, base_score=600, base_odds=50, # skala skor: 600 poin = odds baik:buruk 50:1, +20 poin = odds 2×\n",
    "    n_sims=10_000, conf=0.99, test_size=0.3, seed=42,\n",
    ")\n",
    "\n",
    "# --- Format angka Indonesia, hanya pada angka (tanda baca teks tidak diubah): 1,234.5 → 1.234,5 ---\n",
    "idn = lambda s: re.sub(r\"\\d[\\d,.]*\\d\", lambda a: a.group().translate(str.maketrans(\",.\", \".,\")), s)\n",
    "pct = lambda x, d=1: idn(f\"{x:.{d}%}\")                             # 0.0169 → \"1,7%\"\n",
    "num = lambda x, d=3: idn(f\"{x:,.{d}f}\")                            # 45000 → \"45.000\"\n",
    "status = lambda x, hijau, kuning: str(np.select([x <= hijau, x <= kuning], [\"HIJAU\", \"KUNING\"], \"MERAH\"))\n",
    "\n",
    "# Nama fitur yang mudah dibaca untuk tabel dan grafik\n",
    "nama_fitur = {\n",
    "    \"RevolvingUtilizationOfUnsecuredLines\": \"Pemakaian limit kredit\", \"age\": \"Usia\",\n",
    "    \"NumberOfTime30-59DaysPastDueNotWorse\": \"Telat bayar 30-59 hari\", \"NumberOfTime60-89DaysPastDueNotWorse\": \"Telat bayar 60-89 hari\",\n",
    "    \"NumberOfTimes90DaysLate\": \"Telat bayar 90+ hari\", \"DebtRatio\": \"Debt ratio\", \"MonthlyIncome\": \"Pendapatan bulanan\",\n",
    "    \"NumberOfOpenCreditLinesAndLoans\": \"Jumlah kredit aktif\", \"NumberRealEstateLoansOrLines\": \"Jumlah kredit properti\",\n",
    "    \"NumberOfDependents\": \"Jumlah tanggungan\", \"missingindicator_MonthlyIncome\": \"Pendapatan tidak diisi\",\n",
    "    \"missingindicator_NumberOfDependents\": \"Tanggungan tidak diisi\",\n",
    "}\n",
    "\n",
    "def tampil(judul, df, catatan=None):                               # tabel hasil: judul + tabel + cara membaca\n",
    "    display(Markdown(f\"**{judul}**\"))\n",
    "    with pd.option_context(\"display.max_colwidth\", None):\n",
    "        display(df)\n",
    "    if catatan:\n",
    "        display(Markdown(f\"*Cara membaca:* {catatan}\"))\n",
    "\n",
    "# --- Gaya grafik siap PPT: kanvas 16:9, huruf besar, warna konsisten ---\n",
    "C = dict(navy=\"#1F3A5F\", teal=\"#2A9D8F\", merah=\"#E76F51\", emas=\"#E9A23B\", abu=\"#8D99AE\", teks=\"#2B2D42\", latar=\"#F1F4F8\")\n",
    "warna_status = {\"HIJAU\": C[\"teal\"], \"KUNING\": C[\"emas\"], \"MERAH\": C[\"merah\"]}\n",
    "sns.set_theme(style=\"white\", rc={\n",
    "    \"font.size\": 12, \"axes.titlesize\": 14, \"axes.titleweight\": \"bold\", \"axes.titlelocation\": \"left\", \"axes.titlepad\": 12,\n",
    "    \"axes.titlecolor\": C[\"teks\"], \"axes.labelsize\": 12, \"axes.labelcolor\": C[\"teks\"], \"xtick.labelsize\": 11,\n",
    "    \"ytick.labelsize\": 11, \"xtick.color\": C[\"teks\"], \"ytick.color\": C[\"teks\"], \"axes.edgecolor\": \"#C8CDD3\",\n",
    "    \"axes.spines.top\": False, \"axes.spines.right\": False, \"axes.grid\": True, \"axes.grid.axis\": \"y\",\n",
    "    \"grid.color\": \"#E6E9ED\", \"legend.frameon\": False, \"legend.fontsize\": 11, \"savefig.dpi\": 200})\n",
    "fmt_pct = mtick.FuncFormatter(lambda v, _: pct(v, 0))             # sumbu dalam pecahan → \"5%\"\n",
    "os.makedirs(\"images\", exist_ok=True)                               # tempat simpan grafik (juga saat dibuka di Colab)\n",
    "\n",
    "def slide(judul, subjudul):                                        # kanvas 16:9: judul = pesan utama\n",
    "    fig = plt.figure(figsize=(13.33, 7.5))\n",
    "    fig.text(0.03, 0.955, judul, fontsize=21, fontweight=\"bold\", color=C[\"navy\"], va=\"top\")\n",
    "    fig.text(0.03, 0.885, subjudul, fontsize=13, color=C[\"abu\"], va=\"top\")\n",
    "    fig.text(0.03, 0.02, f\"Sumber: Give Me Some Credit (OpenML), data validation {num(len(X_val), 0)} peminjam. \"\n",
    "             f\"Asumsi: LGD {pct(P['lgd'], 0)}, korelasi {pct(P['rho'], 0)}, margin {pct(P['margin'], 0)}.\",\n",
    "             fontsize=9.5, color=C[\"abu\"])\n",
    "    return fig"
   ]
