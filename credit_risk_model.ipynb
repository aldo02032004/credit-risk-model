    "            f\"Simulasi Monte Carlo {num(P['n_sims'], 0)} skenario ekonomi (model Vasicek satu faktor) dan stress test\")\n",
    "ax = fig.subplots(1, 2, gridspec_kw={\"width_ratios\": [1.1, 1]})\n",
    "fig.subplots_adjust(top=0.76, bottom=0.16, left=0.07, right=0.98, wspace=0.2)\n",
    "bins = np.linspace(0, np.quantile(L, 0.999), 70)\n",
    "for c, lab, col in [(L, \"Tanpa cutoff\", C[\"abu\"]), (L_cut, \"Dengan cutoff\", C[\"teal\"])]:\n",
    "    ax[0].hist(c, bins=bins, color=col, alpha=0.6, label=lab)\n",
    "ymax = ax[0].get_ylim()[1]\n",
    "for c, col, lab, ha in [(mt, C[\"teks\"], \"tanpa cutoff\", \"left\"), (mc, C[\"teal\"], \"dengan cutoff\", \"right\")]:\n",
    "    ax[0].axvline(c[\"VaR 99\"], color=col, ls=\"--\", lw=2)\n",
    "    ax[0].text(c[\"VaR 99\"] + (0.001 if ha == \"left\" else -0.001), ymax * 0.6, f\"VaR 99\\n{lab}\\n{pct(c['VaR 99'], 2)}\",\n",
    "               ha=ha, fontsize=11, fontweight=\"bold\", color=col, linespacing=1.4)\n",
    "ax[0].set(title=\"Sebaran kerugian 12 bulan\", xlabel=\"Kerugian dalam setahun (% portofolio)\", ylabel=\"Jumlah skenario\")\n",
    "ax[0].xaxis.set_major_formatter(fmt_pct)\n",
    "ax[0].yaxis.set_major_formatter(mtick.FuncFormatter(lambda x, _: num(x, 0)))\n",
    "ax[0].legend(loc=\"upper right\")\n",
    "\n",
    "xs, w = np.arange(len(stres)), 0.38\n",
    "for i, (k, col, lab) in enumerate([(\"Rugi tanpa cutoff\", C[\"abu\"], \"Tanpa cutoff\"), (\"Rugi dengan cutoff\", C[\"teal\"], \"Dengan cutoff\")]):\n",
    "    b = ax[1].bar(xs + (i - 0.5) * w, stres[k], w, color=col, label=lab)\n",
    "    ax[1].bar_label(b, labels=[pct(x) for x in stres[k]], fontsize=10.5, padding=3,\n",
    "                    bbox=dict(fc=\"white\", ec=\"none\", pad=1.5))\n",
    "ax[1].axhline(mt[\"EL\"], color=C[\"navy\"], ls=\":\", lw=1.8, label=f\"Expected loss tanpa cutoff ({pct(mt['EL'])})\")\n",
    "ax[1].set_xticks(xs, [\"Tahun biasa\\n(Z = 0)\"] + [f\"{nama_skenario[k]}\\n1 dari {num(n, 0)} tahun\"\n",
    "                                                 for k, n in zip(stres.index[1:], stres[\"1 dari N tahun\"][1:])])\n",
    "ax[1].set(title=\"Stress test: kerugian saat ekonomi memburuk\", ylabel=\"Kerugian (% portofolio)\")\n",
    "ax[1].yaxis.set_major_formatter(fmt_pct)\n",
    "ax[1].legend(loc=\"upper left\")\n",
    "fig.savefig(\"images/04_kerugian.png\"); plt.show()"
