        "gm = fetch_openml(data_id=46929, as_frame=True).frame\n",
        "y = (gm.pop(\"FinancialDistressNextTwoYears\") == \"Yes\").astype(int)\n",
        "kosong = gm.isna().mean()[lambda s: s > 0]\n",
        "print(f\"Default rate 2 tahun: {pct(y.mean(), 2)}. Data kosong: \"\n",
        "      + \", \".join(f\"{nama_fitur[k]} {pct(v)}\" for k, v in kosong.items()))"
      ]
    },
