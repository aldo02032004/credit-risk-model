        "fig = slide(f\"Cutoff {cutoff:.0f} poin menolak {pct(1 - ap)} pengajuan yang hampir separuhnya gagal bayar\",\n",
        "            \"Cutoff = titik impas: margin 8% dari pinjaman lancar harus menutup kerugian (LGD 45%) dari pinjaman gagal bayar\")\n",
        "ax = fig.subplots(1, 2, gridspec_kw={\"width_ratios\": [1, 1.15]})\n",
        "fig.subplots_adjust(top=0.76, bottom=0.14, left=0.07, right=0.98, wspace=0.18)\n",
        "x = np.arange(1, 11)\n",
        "ax[0].bar(x, band.default_aktual, width=0.7, color=[C[\"merah\"]] + [C[\"navy\"]] * 9, label=\"Default rate aktual\")\n",
        "ax[0].plot(x, band.pd_prediksi, \"o-\", color=C[\"emas\"], lw=2, ms=6, label=\"PD prediksi model\")\n",
        "for xi, d, p in zip(x, band.default_aktual, band.pd_prediksi):\n",
        "    ax[0].text(xi, max(d, p) + 0.008, pct(d), ha=\"center\", fontsize=10, color=C[\"teks\"], zorder=5,\n",
        "               bbox=dict(fc=\"white\", ec=\"none\", pad=1.5))\n",
        "ax[0].set(title=\"Default rate per desil skor\", xlabel=\"Desil skor (1 = paling berisiko, 10 = paling aman)\",\n",
        "          ylabel=\"Gagal bayar dalam 2 tahun\", xticks=x)\n",
        "ax[0].yaxis.set_major_formatter(fmt_pct)\n",
        "ax[0].legend(loc=\"upper right\")\n",
        "\n",
        "bins = np.linspace(port.skor.min(), port.skor.max(), 70)\n",
        "for lab, d, col in [(\"Peminjam lancar\", port[port.default == 0], C[\"teal\"]),\n",
        "                    (\"Peminjam gagal bayar\", port[port.default == 1], C[\"merah\"])]:\n",
        "    ax[1].hist(d.skor, bins=bins, density=True, color=col, alpha=0.55, label=lab)\n",
        "ymax = ax[1].get_ylim()[1]\n",
        "ax[1].axvspan(bins[0], cutoff, color=C[\"merah\"], alpha=0.08)\n",
        "ax[1].axvline(cutoff, color=C[\"navy\"], ls=\"--\", lw=2)\n",
        "ax[1].text(cutoff - 4, ymax * 0.97, f\"DITOLAK\\n{pct(1 - ap)} pengajuan\\nbad rate {pct(cut['Bad rate aktual, ditolak'])}\",\n",
        "           ha=\"right\", va=\"top\", fontsize=11.5, fontweight=\"bold\", color=C[\"merah\"], linespacing=1.5)\n",
        "ax[1].text(cutoff + 4, ymax * 0.97, f\"DITERIMA\\n{pct(ap)} pengajuan\\nbad rate {pct(cut['Bad rate aktual, lolos'])}\",\n",
        "           ha=\"left\", va=\"top\", fontsize=11.5, fontweight=\"bold\", color=C[\"teal\"], linespacing=1.5)\n",
        "ax[1].set(title=\"Sebaran skor peminjam lancar vs gagal bayar\", xlabel=\"Skor kredit (makin tinggi makin aman)\",\n",
        "          ylabel=\"Sebaran peminjam\", yticks=[])\n",
        "ax[1].legend(loc=\"center left\", bbox_to_anchor=(0, 0.55))\n",
        "fig.savefig(\"images/03_cutoff.png\"); plt.show()"
